{
  "name": "orbitbom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run worker",
    "dev": "next dev",
    "prebuild": "npm run worker",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "worker": "esbuild src/lib/recognize/teeth.worker.ts --bundle --minify --format=iife --log-level=warning --outfile=public/teeth-worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "onshape:test": "tsx scripts/onshape-test.ts",
    "drawing:spike": "tsx scripts/drawing-spike.ts",
    "sheetmetal:spike": "tsx scripts/sheet-metal-spike.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@types/pg": "^8.23.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.12",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
